metry x="40.0" y="444.0" width="1320.0" height="24.0" as="geometry" /></mxCell><mxCell id="c13" value="&lt;b&gt;Osoba:&lt;/b&gt; Dawid" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40.0" y="470.0" width="1320.0" height="24.0" as="geometry" /></mxCell><mxCell id="c14" value="Podstawowy pełny segment ściany fasady, z którego składa się większość budynku. Płaska bryła 2 x 3 m o grubości 0,2 m. W blockoucie wystarczy prostopadłościan, ale warto od razu zaznaczyć fazę na krawędziach i lekkie ugięcie dolnej krawędzi pod brudny cokół. Zacieki, plamy i odpryski tynku przyjdą z materiału." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40.0" y="508.0" width="1320.0" height="58.0" as="geometry" /></mxCell><mxCell id="c15" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/jpeg,;" vertex="1" parent="1"><mxGeometry x="40.0" y="580.0" width="100.0" height="360.0" as="geometry" /></mxCell><mxCell id="c16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E00000;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="45.0" y="590.8" width="90.0" height="338.4" as="geometry" /></mxCell><mxCell id="c17" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E00000;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="43.0" y="588.8" width="24.0" height="24.0" as="geometry" /></mxCell><mxCell id="c18" value="1. beton z zaciekami" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=15;fontColor=#E00000;" vertex="1" parent="1"><mxGeometry x="40.0" y="950.0" width="220.0" height="20.0" as="geometry" /></mxCell><mxCell id="c19" value